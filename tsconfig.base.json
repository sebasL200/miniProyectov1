{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["apps/admin-web/src/app/shared/*"],
      "@categories/*": ["apps/admin-web/src/app/features/categories/*"],
      "@environments/environment": ["apps/admin-web/src/environments/environment.ts"],
      "@org/contracts": ["libs/shared/contracts/src/index.ts"],
      "@org/validations": ["libs/shared/validations/src/index.ts"]
    }
  }
}
