NODE_ENV=local

# Application Ports
API_PORT=3002
ADMIN_PORT=4200
ALLOWED_ORIGINS=http://localhost:${ADMIN_PORT},http://localhost:${API_PORT}

# Database Configuration
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=ecommerce_catalogo_mini
DB_PORT=5432
EXPOSED_DB_PORT=5435
DB_SSL_MODE=disable
STUDIO_PORT=5555

# Database URLs
# Usa LOCAL_DB_URL para ejecutar las migraciones de Prisma desde tu terminal
DB_URL=postgres://${DB_USER}:${DB_PASSWORD}@db:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSL_MODE}
LOCAL_DB_URL=postgres://${DB_USER}:${DB_PASSWORD}@localhost:${EXPOSED_DB_PORT}/${DB_NAME}?sslmode=${DB_SSL_MODE}

# Redis / Valkey Topology (Mantén solo el caché por si la API lo exige para las consultas)
REDIS_CACHE_ADDR=localhost:6379
INFRA_REDIS_CACHE_PORT=6379