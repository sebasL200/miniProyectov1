// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. MARCAS (Brands)
// ==========================================
model Brand {
  id              String    @id @default(uuid())
  name            String
  description     String?
  slug            String
  isActive        Boolean   @default(true) @map("is_active")
  visibleInMenu   Boolean   @default(false) @map("visible_in_menu")
  logoUrl         String    @map("logo_url")
  website         String?
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  products        Product[]

  @@map("brands")
}

// ==========================================
// 2. CATEGORÍAS (Categories)
// ==========================================
model Category {
  id              String              @id @default(uuid())
  parentId        String?             @map("parent_id")
  parent          Category?           @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]          @relation("CategoryChildren")
  name            String
  slug            String
  description     String?
  imageUrl        String?             @map("image_url")
  metaTitle       String?             @map("meta_title")
  metaDescription String?             @map("meta_description")
  isActive        Boolean             @default(true) @map("is_active")
  visibleInMenu   Boolean             @default(false) @map("visible_in_menu")
  deletedAt       DateTime?           @map("deleted_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  productLinks    ProductCategory[]
  attributes      CategoryAttribute[]

  @@index([parentId])
  @@map("categories")
}

// ==========================================
// 3. PRODUCTOS (Products)
// ==========================================
model Product {
  id                 String             @id @default(uuid())
  brandId            String?            @map("brand_id")
  brand              Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name               String             @db.VarChar(150)
  slug               String
  specificationsHtml String?            @map("specifications_html")
  shortDescription   String             @map("short_description") @db.VarChar(300)
  descriptionHtml    String             @map("description_html")
  isActive           Boolean            @default(true) @map("is_active")
  basePrice          Decimal            @map("base_price") @db.Decimal(12, 2)
  skuBase            String?            @map("sku_base") @db.VarChar(100)
  isFeatured         Boolean            @default(false) @map("is_featured")
  isFeaturedContent  Boolean            @default(false) @map("is_featured_content")
  dimensionsWeight   Json?              @map("dimensions_weight")
  metaTitle          String             @map("meta_title") @db.VarChar(200)
  metaDescription    String?            @map("meta_description") @db.VarChar(300)
  deletedAt          DateTime?          @map("deleted_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @map("updated_at")
  categories         ProductCategory[]
  variants           Variant[]
  attributeLinks     ProductAttribute[]

  @@index([brandId])
  @@map("products")
}

// Tabla pivote intermedia para conectar Productos y Categorías (Muchos a Muchos)
model ProductCategory {
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("products_categories")
}

// ==========================================
// 4. VARIANTES DE PRODUCTOS (Variants)
// ==========================================
model Variant {
  id              String                  @id @default(uuid())
  productId       String                  @map("product_id")
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String                  @db.VarChar(32)
  price           Decimal?                @db.Decimal(12, 2)
  minimumStock    Int                     @default(0) @map("minimum_stock")
  barcodeGtin     String?                 @map("barcode_gtin") @db.VarChar(14)
  descriptionHtml String?                 @map("description_html")
  isActive        Boolean                 @default(true) @map("is_active")
  imageUrls       String[]                @default([]) @map("images_urls")
  deletedAt       DateTime?               @map("deleted_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @default(now()) @map("updated_at")
  attributeLinks  VariantAttribute[]
  attributeValues VariantAttributeValue[]

  @@index([productId])
  @@map("variants")
}

// ==========================================
// 5. ATRIBUTOS (Attributes)
// ==========================================
model Attribute {
  id            String                  @id @default(uuid())
  name          String
  slug          String
  description   String?
  displayOrder  Int                     @default(0) @map("display_order")
  isActive      Boolean                 @default(true) @map("is_active")
  isFilterable  Boolean                 @default(false) @map("is_filterable")
  isRequired    Boolean                 @default(false) @map("is_required")
  appliesToAll  Boolean                 @default(false) @map("applies_to_all")
  version       Int                     @default(1)
  deletedAt     DateTime?               @map("deleted_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @default(now()) @map("updated_at")
  categoryLinks CategoryAttribute[]
  productLinks  ProductAttribute[]
  variantLinks  VariantAttribute[]
  variantValues VariantAttributeValue[]

  @@index([displayOrder])
  @@map("attributes")
}

// Relación intermedia: Atributos asignados a Categorías
model CategoryAttribute {
  id          String    @id @default(uuid())
  attributeId String    @map("attribute_id")
  categoryId  String    @map("category_id")
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  @@unique([attributeId, categoryId])
  @@index([attributeId])
  @@index([categoryId])
  @@map("category_attributes")
}

// Relación intermedia: Atributos asignados a Productos
model ProductAttribute {
  productId   String    @map("product_id")
  attributeId String    @map("attribute_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  @@id([productId, attributeId])
  @@index([attributeId])
  @@map("product_attributes")
}

// Relación intermedia: Atributos asignados a Variantes
model VariantAttribute {
  variantId   String    @map("variant_id")
  attributeId String    @map("attribute_id")
  variant     Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  @@id([variantId, attributeId])
  @@index([attributeId])
  @@map("variant_attributes")
}

// Valores de los atributos de las variantes
model VariantAttributeValue {
  variantId   String    @map("variant_id")
  attributeId String    @map("attribute_id")
  value       String
  variant     Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")

  @@id([variantId, attributeId])
  @@index([attributeId])
  @@map("variant_attribute_values")
}